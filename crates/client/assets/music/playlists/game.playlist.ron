// The game's playlist: every tune, its source and whether its rhythm is
// written in the source or ours, and the places it plays in; and who plays,
// by place (`ensembles`; `players` wherever none is named). Made from the
// transcription task's index (tunes.toml).
//
// Places: Wilderness(band, time) with bands Cold, Temperate, Dry, Hot (hot
// and wet) and times Day, Night (Any for every one), WorldMap, Hall, Inn,
// Village (hamlets too), Town, City, Castle (forts too), Tower, Cave (crypts,
// cellars and basements too), Farm, Herbalist, Oasis. A tune with no places
// plays everywhere.
//
// Instruments are General MIDI's bank and program, as `music.sf2` keeps them:
// 74 recorder, 110 fiddle, 24 lute (nylon guitar), 46 harp, 15 psaltery
// (dulcimer), 111 shawm (shanai), 56 trumpet, 57 sackbut (trombone), 109
// bagpipe, 19 church organ, 20 reed organ, 53 voices, 14 tubular bells; bank 8
// has the hurdy-gurdy (110) and cornemuse (109). Percussion uses the standard
// kit's keys: 41 and 45 toms (tabor, nakers, frame drum), 54 tambourine, 60
// and 61 bongos, 76 wood block.
//
// `combat` is what joins in when the player is attacked: a drum (roll and
// ostinato, a kit key: 36 bass drum too) and a stinger (an instrument playing
// the tune's final `above` semitones over middle C's octave; none: the
// drum's accent). Places with none (The Way Inn, the world map) never fight.
//
// Mods add their own `<name>.playlist.ron` beside this one (native builds),
// with tunes and, if they like, players and ensembles; an entry with a known
// id replaces it, and a mod's ensembles win over these for the places they
// name.
(
    players: Some((
        melody: (bank: 0, program: 74),
        second: Some((bank: 0, program: 24)),
        drone: Some((bank: 0, program: 20)),
        percussion: Some((strong: 61, light: 60)),
        link_seconds: 5.0,
        combat: Some((drum: 45)),
    )),
    ensembles: [
        // The wilderness: a pipe and drone, sparser at night.
        (
            places: [Wilderness(Any, Day)],
            players: (
                melody: (bank: 0, program: 74),
                second: Some((bank: 0, program: 24)),
                drone: Some((bank: 0, program: 20)),
                link_seconds: 8.0,
                combat: Some((drum: 45)),
            ),
        ),
        (
            places: [Wilderness(Any, Night)],
            players: (
                melody: (bank: 0, program: 74),
                drone: Some((bank: 0, program: 20)),
                link_seconds: 10.0,
                combat: Some((drum: 41)),
            ),
        ),
        // Highlands and the cold: the cornemuse.
        (
            places: [Wilderness(Cold, Day)],
            players: (
                melody: (bank: 8, program: 109),
                drone: Some((bank: 0, program: 20)),
                link_seconds: 8.0,
                combat: Some((drum: 45)),
            ),
        ),
        // Deserts: shawm and frame drum.
        (
            places: [Wilderness(Dry, Day)],
            players: (
                melody: (bank: 0, program: 111),
                second: Some((bank: 0, program: 24)),
                drone: Some((bank: 0, program: 20)),
                percussion: Some((strong: 41, light: 45)),
                link_seconds: 8.0,
                combat: Some((drum: 41)),
            ),
        ),
        // Hot and wet: recorder, psaltery and hand drums.
        (
            places: [Wilderness(Hot, Day)],
            players: (
                melody: (bank: 0, program: 74),
                second: Some((bank: 0, program: 15)),
                percussion: Some((strong: 61, light: 60)),
                link_seconds: 8.0,
                combat: Some((drum: 61)),
            ),
        ),
        (
            places: [WorldMap],
            players: (
                melody: (bank: 0, program: 46),
                second: Some((bank: 0, program: 74)),
                drone: Some((bank: 0, program: 20)),
                link_seconds: 6.0,
            ),
        ),
        // Organ drone, bells and voices, slow to change.
        (
            places: [Hall],
            players: (
                melody: (bank: 0, program: 53),
                second: Some((bank: 0, program: 14)),
                drone: Some((bank: 0, program: 19)),
                link_seconds: 10.0,
                combat: Some((drum: 41, stinger: Some((instrument: (bank: 0, program: 14), above: 12)))),
            ),
        ),
        // A tavern band.
        (
            places: [Inn],
            players: (
                melody: (bank: 0, program: 110),
                second: Some((bank: 0, program: 24)),
                percussion: Some((strong: 54, light: 54)),
                link_seconds: 3.0,
            ),
        ),
        // More players the larger the town: pipe and tabor with a fiddle; a
        // town adds the hurdy-gurdy's drone and a lute; a city's loud band.
        (
            places: [Village],
            players: (
                melody: (bank: 0, program: 74),
                second: Some((bank: 0, program: 110)),
                percussion: Some((strong: 45, light: 76)),
                link_seconds: 4.0,
                combat: Some((drum: 45)),
            ),
        ),
        (
            places: [Town],
            players: (
                melody: (bank: 0, program: 110),
                second: Some((bank: 0, program: 24)),
                drone: Some((bank: 8, program: 110)),
                percussion: Some((strong: 45, light: 76)),
                link_seconds: 3.0,
                combat: Some((drum: 45, stinger: Some((instrument: (bank: 0, program: 57), above: 0)))),
            ),
        ),
        (
            places: [City],
            players: (
                melody: (bank: 0, program: 111),
                second: Some((bank: 0, program: 57)),
                drone: Some((bank: 0, program: 111)),
