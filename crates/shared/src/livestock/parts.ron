// Organs, fats and other parts butchering gives (`shared::livestock::Parts`),
// from the research in `docs/context/research-livestock.md`. Effects are the
// research's proposals: Alchemy's use of organs is still to be decided
// (decision 10). Drop chances: `livestock::organ_chance` (decision 9).
(
    organs: [
        (key: "liver", name: "liver", from: [All], food: "pâté, liver sausage; calf's liver prized",
            effects: [(stat: Health, change: 2)], base: 70, quest: "a fresh calf's liver"),
        (key: "foie_gras", name: "foie gras", from: [Animal("duck"), Animal("muscovy_duck"), Animal("goose")],
            only: Some(Fattened), food: "the finest liver",
            effects: [(stat: Health, change: 1), (stat: Toughness, change: 1)], base: 100, quest: "Legendary food for feasts"),
        (key: "heart", name: "heart", from: [All], food: "grilled, stewed",
            effects: [(stat: Will, change: 1)], base: 60, quest: "a prize bull's heart"),
        (key: "kidneys", name: "kidneys", from: [Mammals], food: "pies, stews",
            effects: [(stat: Toughness, change: 1)], base: 60),
        (key: "tongue", name: "tongue", from: [Mammals, Animal("duck"), Animal("muscovy_duck")], food: "pressed, smoked (reindeer)",
            effects: [(stat: Presence, change: 1)], base: 50),
        (key: "brain", name: "brain", from: [Mammals], food: "fried; calf's brain a delicacy",
            effects: [(stat: Intellect, change: 1)], other: "brain-tanning softens hides (buckskin)", base: 30),
        (key: "sweetbreads", name: "sweetbreads", from: [Mammals], only: Some(Young), food: "a delicacy for the sick",
            effects: [(stat: Toughness, change: 1)], base: 30),
        (key: "tripe", name: "tripe", from: [Ruminants], food: "stews, soups, haggis",
            effects: [(stat: Toughness, change: 1)], other: "eases a hangover", base: 70),
        (key: "rennet_stomach", name: "rennet stomach",
            from: [Animal("cattle"), Animal("highland_cattle"), Animal("water_buffalo"), Animal("yak"), Animal("sheep"), Animal("goat")],
            only: Some(Young), effects: [(stat: Health, change: 1)],
            other: "cheese-making: each kind's rennet suits its own milk", base: 50, quest: "cheese-makers' orders"),
        (key: "gizzard", name: "gizzard", from: [Birds], food: "confit, giblets",
            effects: [(stat: Toughness, change: 2)], other: "the dried lining for digestion", base: 80),
        (key: "blood", name: "blood", from: [All], food: "black pudding, blood soup",
            effects: [(stat: Health, change: 2)], other: "sacrifices and rituals", base: 80, bottled: true, quest: "rituals"),
        (key: "bile", name: "bile",
            from: [Animal("cattle"), Animal("highland_cattle"), Animal("water_buffalo"), Animal("yak"), Animal("sheep"), Animal("goat"), Animal("pig"), Birds],
            except: ["pigeon"], effects: [(stat: Will, change: 2)],
            other: "ox gall soap, watercolour; no gall bladder in horses, camels, llamas, reindeer or pigeons",
            base: 40, quest: "painters, launderers"),
        (key: "gallstone", name: "ox bezoar",
            from: [Animal("cattle"), Animal("highland_cattle"), Animal("water_buffalo"), Animal("yak")], only: Some(Old),
            effects: [(stat: Health, change: 3)], other: "a gallstone worth a fortune", base: 1, stone: true, quest: "a prime target"),
        (key: "bezoar", name: "bezoar",
            from: [Animal("goat"), Animal("dromedary"), Animal("bactrian_camel"), Animal("llama"), Animal("alpaca")],
            other: "cures poison (decision 10: perhaps Cure Poison with Toughness); set in rings; wild goats' best",
            base: 1, stone: true, quest: "a prime target"),
        (key: "testicles", name: "testicles", from: [All], only: Some(IntactMale), food: "lamb fries, criadillas",
            effects: [(stat: Strength, change: 2)], base: 95),
        (key: "marrow", name: "marrow", from: [Mammals], food: "roasted bones, ossobuco",
            effects: [(stat: Toughness, change: 1)], base: 90),
        (key: "os_cordis", name: "os cordis", from: [Animal("cattle"), Animal("highland_cattle")], only: Some(Old),
            effects: [(stat: Aura, change: 2)], other: "a bone in the heart, worn as an amulet", base: 2, stone: true, quest: "a prime target"),
        (key: "wishbone", name: "wishbone", from: [Birds],
            effects: [(stat: Aura, change: 1)], other: "wishing, oracles", base: 90, quest: "children's errands"),
        (key: "shoulder_blade", name: "shoulder blade", from: [Animal("sheep"), Animal("cattle"), Animal("highland_cattle"), Animal("goat")],
            effects: [(stat: Mana, change: 1)], other: "a hoe's blade; divination", base: 90, quest: "seers"),
        (key: "antler_velvet", name: "antler velvet", from: [Animal("reindeer")], only: Some(GrowingAntlers),
            effects: [(stat: Strength, change: 2)], other: "a tonic", base: 60, quest: "in season"),
        (key: "scent_glands", name: "scent glands", from: [Animal("goat")], only: Some(IntactMale),
