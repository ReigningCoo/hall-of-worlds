        (key: "cockscomb", name: "cockscomb", from: [Animal("chicken")], only: Some(IntactMale), food: "a garnish",
            effects: [(stat: Presence, change: 1)], base: 95),
        (key: "lungs", name: "lungs", from: [Mammals], food: "haggis, faggots", base: 70),
        (key: "bladder", name: "bladder", from: [Mammals], other: "a waterproof pouch, a ball", base: 50),
        (key: "intestines", name: "intestines", from: [All], food: "sausage casings, chitterlings",
            other: "catgut: bow and harp strings, sutures", base: 60),
    ],
    fats: [
        (key: "leaf_lard", name: "leaf lard", from: [Animal("pig")], note: "the best lard, from round the kidneys"),
        (key: "lard", name: "lard", from: [Animal("pig")], note: "fatback and the rest"),
        (key: "suet", name: "suet", from: [Animal("cattle"), Animal("highland_cattle"), Animal("sheep"), Animal("goat")],
            note: "hard kidney fat, rendered into tallow"),
        (key: "tallow", name: "tallow", from: [Animal("cattle"), Animal("highland_cattle"), Animal("sheep"), Animal("goat")],
            rendered_from: Some("suet"), note: "candles, soap, leather dressing"),
        (key: "goose_fat", name: "goose fat", from: [Animal("goose")], note: "the finest of fats; a chest rub"),
        (key: "duck_fat", name: "duck fat", from: [Animal("duck"), Animal("muscovy_duck")], note: "confit"),
        (key: "schmaltz", name: "schmaltz", from: [Animal("chicken")], note: "cooking"),
        (key: "hump_fat", name: "hump fat", from: [Animal("dromedary"), Animal("bactrian_camel")], note: "a prized cooking fat, a salve for aches"),
        (key: "fat_tail", name: "fat tail", from: [Animal("sheep")], note: "fat-tailed breeds only: cooking fat"),
    ],
    others: [
        (key: "bones", name: "bones", from: [All],
            uses: "bone tools (needles, awls, combs, handles, dice, flutes), bone meal, bone char (a filter), bone ash, stock, glue"),
        (key: "horn", name: "horn",
            from: [Animal("cattle"), Animal("highland_cattle"), Animal("water_buffalo"), Animal("yak"), Animal("sheep"), Animal("goat")],
            uses: "drinking horns, horn bows with sinew, combs, handles, buttons, spoons, windows, glue"),
        (key: "antlers", name: "antlers", from: [Animal("reindeer")],
            uses: "the best bone for tools; hartshorn jelly; shed each year, so found as well"),
        (key: "hooves", name: "hooves",
            from: [Animal("horse"), Animal("cattle"), Animal("highland_cattle"), Animal("donkey"), Animal("mule"), Animal("dromedary"), Animal("bactrian_camel")],
            uses: "glue"),
        (key: "tusks", name: "tusks", from: [Animal("pig")], only: Some(IntactMale), uses: "carving, charms"),
        (key: "sinew", name: "sinew", from: [Mammals], uses: "thread, bowstrings, bow backing, lashings; shrinks tight as it dries"),
        (key: "feathers", name: "feathers", from: [Birds], uses: "fletching, quill pens (goose), stuffing, ornament (guineafowl, turkey)"),
        (key: "down", name: "down", from: [Animal("goose"), Animal("duck"), Animal("muscovy_duck")], uses: "bedding, quilted padding; goose's best"),
        (key: "hair", name: "hair",
            from: [Animal("horse"), Animal("yak"), Animal("pig"), Animal("cattle"), Animal("highland_cattle")],
            uses: "instruments' bow strings, brushes, rope, fly whisks"),
        (key: "fleece", name: "wool and fleece",
            from: [Animal("sheep"), Animal("goat"), Animal("alpaca"), Animal("llama"), Animal("yak"), Animal("dromedary"), Animal("bactrian_camel"), Animal("rabbit")],
            uses: "spun into yarn for cloth; lambswool finest, old rams coarsest"),
    ],
)
